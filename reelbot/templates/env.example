# Copy to .env (git-ignored) and fill in. Only the instagrapi backend needs these.
# Leave a value empty and reelbot will tell you it is missing rather than
# attempting a login with a placeholder.
IG_USERNAME=
IG_PASSWORD=

# Only if the account has two-factor auth enabled. Paste the TOTP *seed*
# (the "can't scan the code?" key), not a 6-digit code — reelbot generates
# the current code at login time.
IG_TOTP_SEED=

# Set this if the review UI is reachable from other machines (a Docker
# container, a Raspberry Pi on your LAN). Required for a non-localhost bind.
REELBOT_REVIEW_PASSWORD=

# Only for the optional official Graph API backend (publish.backend: graph)
IG_USER_ID=
IG_ACCESS_TOKEN=
PUBLIC_BASE_URL=
