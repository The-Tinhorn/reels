# Copy to .env (git-ignored) and fill in the variables for your backend.
# These login fields are only for the legacy instagrapi backend.
IG_USERNAME=
IG_PASSWORD=

# Only if the account has two-factor auth enabled. Paste the TOTP *seed*
# (the "can't scan the code?" key), not a 6-digit code — reelbot generates
# the current code at login time.
IG_TOTP_SEED=

# Set this if the review UI is reachable from other machines (a Docker
# container, a Raspberry Pi on your LAN). Required for a non-localhost bind.
REELBOT_REVIEW_PASSWORD=

# For the official Graph API backend (publish.backend: graph).
# Use the Instagram account ID and Page access token from Meta Graph API Explorer.
IG_USER_ID=
IG_ACCESS_TOKEN=

# Overrides the caption template even when config.yaml predates this image.
# Leave blank to use config.yaml; set to {title} to override older templates.
REELBOT_CAPTION_TEMPLATE=
